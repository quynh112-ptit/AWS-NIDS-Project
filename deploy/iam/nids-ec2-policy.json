{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishNidsAlertsOnly",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:400131408828:NIDS-Alerts"
    },
    {
      "Sid": "ListBackupBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::nids-backup-nhom07"
    },
    {
      "Sid": "ReadWriteBackupObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::nids-backup-nhom07/postgres/*",
        "arn:aws:s3:::nids-backup-nhom07/events/*"
      ]
    }
  ]
}
