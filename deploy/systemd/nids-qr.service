[Unit]
Description=NIDS Web QR attack simulator (Streamlit :8502)
After=docker.service network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__/tv3
EnvironmentFile=-__ROOT__/.env
ExecStart=__PY__ -m streamlit run qr_attack_app.py --server.address 0.0.0.0 --server.port 8502 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
