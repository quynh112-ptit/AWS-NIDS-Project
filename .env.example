# ============================================================
# Mẫu cấu hình môi trường NIDS. Sao chép thành .env rồi điền giá trị.
#   cp .env.example .env
# File .env đã nằm trong .gitignore → KHÔNG bao giờ commit lên GitHub.
# ============================================================

# --- Kafka ---
# Cổng công khai cho Producer bên ngoài. Mặc định 9092; đổi thành 9091 nếu cần.
KAFKA_PORT=9092
# start_nids.sh tự điền IP Public EC2
KAFKA_PUBLIC_HOST=localhost
# Tiến trình chạy trên chính EC2 dùng listener nội bộ 29092 (start_nids.sh tự điền).
# Producer ở máy khác dùng <IP_PUBLIC_EC2>:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
NIDS_KAFKA=localhost:29092

# --- PostgreSQL ---
POSTGRES_USER=nids_user
POSTGRES_PASSWORD=doi_mat_khau_manh_o_day
POSTGRES_DB=nids_db
# 0.0.0.0 nếu cần truy cập từ xa (nhớ giới hạn IP trong Security Group)
POSTGRES_BIND=127.0.0.1
NIDS_DSN=postgresql://nids_user:doi_mat_khau_manh_o_day@localhost:5432/nids_db

# --- AWS (xác thực bằng IAM Role của EC2, KHÔNG điền Access Key) ---
AWS_DEFAULT_REGION=us-east-1
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:400131408828:NIDS-Alerts
# Tên bucket S3 dùng cho sao lưu (phải là tên duy nhất toàn cầu)
BACKUP_S3_BUCKET=nids-backup-nhom07
# số bản sao lưu giữ lại trên ổ EBS
BACKUP_RETENTION_DAYS=7
